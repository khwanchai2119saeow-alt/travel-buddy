{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "../.test-out",
    "rootDir": "../src",
    "baseUrl": "..",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "jsx": "react-jsx",
    "noEmitOnError": false
  },
  "files": [
    "../src/lib/receipt.ts",
    "../src/lib/csv.ts",
    "../src/lib/people.ts",
    "../src/lib/geo.ts",
    "../src/lib/format.ts",
    "../src/lib/invite.ts",
    "../src/lib/stats.ts",
    "../src/lib/receiptWords.ts",
    "../src/lib/signs.ts",
    "../src/lib/validate.ts"
  ]
}